{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "godlevski-api",
  "main": "index.ts",
  "compatibility_date": "2026-08-01",

  // no "vars" here by design — ALL config travels from the env vault
  // (.env.production[.local], or CI env) at deploy time via
  // scripts/deploy-worker.sh --var injection; secrets via
  // scripts/push-secrets.sh. This file declares bindings only.
  // (wrangler dev parity path reads .dev.vars — gitignored.)

  // sqlite locally (miniflare), D1 remotely — same binding either way
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "godlevski-db",
      "database_id": "b033b985-6b1d-4afe-bec0-562ef0fa0e7c",
      "migrations_dir": "../../infra/migrations/godlevski-db"
    }
  ],

  "observability": {
    "enabled": true
  }
}
