{
  "name": "worker-godlevski-api",
  "version": "1.0.0",
  "description": "godlevski.com api worker — agnostic controllers over D1",
  "author": "Dmitriy Godlevski",
  "license": "MIT",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch test-runner.ts",
    "dev:wrangler": "wrangler dev --port 4300",
    "deploy:worker": "bash ../../scripts/deploy-worker.sh godlevski-api",
    "db:migrate:local:wrangler": "wrangler d1 migrations apply godlevski-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply godlevski-db --remote",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@godlevski/agnostic-lambda": "workspace:*",
    "@godlevski/schemas": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "multer": "^2.0.2",
    "@types/node": "^22.15.14",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
