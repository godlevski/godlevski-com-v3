# committed dev defaults (express runner) — override per-machine in .env.development.local
PORT=4300
HOST=127.0.0.1
# repo-local sqlite backing the D1 shim (relative to this folder)
LOCAL_SQLITE_PATH=../../local/godlevski-db.sqlite
OMIT_PATH_PREFIX=/api
SERVICE_NAME="godlevski-api (express)"

# email verification (see wrangler.jsonc vars for prod values)
EMAIL_FROM="Godlevski Automatic Message <dmitriy@godlevski.com>"
EMAIL_LINK_BASE=http://localhost:8080/api
TOKEN_EXPIRATION_MS=259200000
EMAIL_VERIFICATION_LIFESPAN_MS=86400000
EMAIL_VERIFICATION_REQUEST_LIFESPAN_MS=54000000
EMAIL_HOOK_LIFESPAN_MS=7200000
# dev-only signing secret (prod: wrangler secret put JWT_SECRET)
JWT_SECRET=dev-only-jwt-secret
# RESEND_API_KEY intentionally absent in dev -> emails log to console;
# to send real mail locally, put the key in .env.development.local
