{
  "name": "godlevski",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev --env-mode ${ENV_MODE:-development}",
    "build": "ENV_MODE=${ENV_MODE:-production} rsbuild build --env-mode ${ENV_MODE:-production}",
    "build:dev": "ENV_MODE=development pnpm build",
    "build:prod": "ENV_MODE=production pnpm build",
    "preview": "rsbuild preview",
    "lint": "echo 'js app migrated from CRA — lint/ts comes in step 2'",
    "clear-cache": "rm -rf node_modules/.cache"
  },
  "dependencies": {
    "@react-spring/web": "^10.0.3",
    "animated-scroll-to": "2.2.0",
    "axios": "0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "6.2.1",
    "react-spring": "^10.0.3",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.6.14",
    "@rsbuild/plugin-react": "^1.4.2",
    "typescript": "^5.9.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
